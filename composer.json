{
    "name": "puff/console",
    "description": "Decoupled CLI and code generators for PHP Unison Fiber Framework",
    "type": "library",
    "keywords": [
        "php",
        "console",
        "cli",
        "code-generator",
        "puff"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Puff\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puff\\Console\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse src tests --level=8 --no-progress --memory-limit=1G",
        "test": "phpunit tests"
    }
}
