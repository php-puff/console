{
    "name": "puff/console",
    "description": "Decoupled CLI and code generators for PHP Unison Fiber Framework",
    "type": "library",
    "keywords": [
        "php",
        "console",
        "cli",
        "code-generator",
        "puff"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Puff\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puff\\Console\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
